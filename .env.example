# Cada deploy (Porto Terapia e Grupo IB) usa o SEU PRÓPRIO projeto Supabase.
# Nunca aponte os dois sites para o mesmo projeto.
# URL do projeto do Supabase (ex: https://xyz.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Chave anônima / pública (anon/public key) do Supabase
VITE_SUPABASE_ANON_KEY=your-anon-key

# NÃO adicione chaves de API de terceiros aqui (Gemini, etc.) com o prefixo
# VITE_ — qualquer variável VITE_* vai para o bundle do navegador e fica
# pública. A chave do Gemini usada pela sincronização Grupo IB é lida como
# segredo da Edge Function (GEMINI_API_KEY via `supabase secrets set`), nunca
# como variável de build do front-end.

# Qual workspace este deploy representa (ver src/config/branding.porto.js e
# branding.grupoib.js). 'porto-terapia' (padrão) ou 'grupoib'. O build inclui só
# os dados do workspace escolhido. Os dois sites são totalmente independentes:
# projeto Supabase, contas e dados próprios.
VITE_WORKSPACE_ID=porto-terapia

# Opcional: URL da função de recuperação de senha. Padrão: a definida no
# branding do workspace (Porto) ou a função recuperar-senha do projeto Supabase
# deste deploy.
# VITE_RECUPERAR_SENHA_URL=
